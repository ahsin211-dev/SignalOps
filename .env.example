# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (optional — AI features degrade gracefully when unset)
OPENAI_API_KEY=

# Slack OAuth (optional)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Google OAuth (Gmail + Sheets) (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis for BullMQ worker (optional — falls back to in-memory queue in dev)
REDIS_URL=redis://localhost:6379

# Internal webhook / job auth (rotate in production)
INTERNAL_JOB_SECRET=change-me
